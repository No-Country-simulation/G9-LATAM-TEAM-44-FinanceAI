# ==================================================
# Python
# ==================================================

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-ds/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checking and linting
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# Dataset generado. No se versiona porque son ~65.000 filas que se reproducen
# exactamente con:
#   python ciencia-datos/scripts/generador_usuarios.py --semilla 42
ciencia-datos/datos/

# Modelos serializados: la fuente de verdad es OCI Object Storage.
*.pkl
*.joblib
*.onnx

# Excepcion: los artefactos entrenados si se versionan (~3 MB). Sin ellos, un
# clon sin credenciales de OCI arrancaria en modo degradado.
!ciencia-datos/artefactos/*.joblib

# Environment variables
.env
.env.*
!.env.example


# ==================================================
# Java
# ==================================================

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear
*.nar

# Java logs
*.log

# JVM crash logs
hs_err_pid*
replay_pid*

# Logs del lanzador iniciar.sh
.logs/

# Maven. mvnw, mvnw.cmd y .mvn/wrapper/ si se versionan: permiten compilar sin
# tener Maven instalado.
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.mvn/timing.properties

# Gradle
.gradle/
**/build/
!src/**/build/
gradle-app.setting
.gradletasknamecache

# Eclipse
.metadata/
.classpath
.project
.settings/
bin/
tmp/

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/


# ==================================================
# Node / Frontend
# ==================================================

node_modules/
.pnp/
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output de Vite / Next
.vite/
.next/
.nuxt/
.svelte-kit/
.turbo/

# Cache de linters / formatters
.eslintcache
.stylelintcache


