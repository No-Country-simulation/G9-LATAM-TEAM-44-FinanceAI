{
  "info": {
    "name": "FinanceAI – Colección de pruebas",
    "_postman_id": "financeai-team44-pruebas",
    "description": "Prueba las dos piezas del sistema.\n\n• Carpeta 'ml-service (contrato)': el servicio FastAPI del contrato en :8000 (financeai-ml-contract). Funciona hoy con el stub y seguirá válida cuando entren los modelos reales.\n\n• Carpeta 'finance-ai-api (backend)': el orquestador Spring Boot en :8080, con los 3 ejemplos oficiales en snake_case (formato del reto). Nota: el backend actual expone camelCase; hasta aplicar spring.jackson.property-naming-strategy=SNAKE_CASE usar la petición marcada como 'camelCase (backend actual)'.\n\nCorrer todo por consola: newman run FinanceAI.postman_collection.json --folder \"ml-service (contrato)\"",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "ml_url", "value": "http://localhost:8000" },
    { "key": "api_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "ml-service (contrato)",
      "item": [
        {
          "name": "Health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 y status ok', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().status).to.eql('ok');",
            "});"
          ]}}],
          "request": { "method": "GET", "url": "{{ml_url}}/health" }
        },
        {
          "name": "Modelo info",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 con categorias y perfiles canónicos', function () {",
            "  pm.response.to.have.status(200);",
            "  const b = pm.response.json();",
            "  pm.expect(b.categorias).to.have.lengthOf(8);",
            "  pm.expect(b.perfiles).to.eql(['Saludable', 'En observación', 'En riesgo']);",
            "});"
          ]}}],
          "request": { "method": "GET", "url": "{{ml_url}}/modelo/info" }
        },
        {
          "name": "Clasificar – lote de transacciones",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const CANONICAS = ['alimentacion','transporte','salud','vivienda','educacion','ocio','servicios','otras'];",
            "pm.test('200 y misma cantidad de transacciones', function () {",
            "  pm.response.to.have.status(200);",
            "  const tx = pm.response.json().transacciones_clasificadas;",
            "  pm.expect(tx).to.have.lengthOf(4);",
            "});",
            "pm.test('categorías canónicas y confianza en [0,1]', function () {",
            "  const tx = pm.response.json().transacciones_clasificadas;",
            "  tx.forEach(t => {",
            "    pm.expect(CANONICAS).to.include(t.categoria);",
            "    pm.expect(t.confianza).to.be.within(0, 1);",
            "  });",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{ml_url}}/clasificar",
            "body": { "mode": "raw", "raw": "{\n  \"transacciones\": [\n    { \"descripcion\": \"Supermercado Exito\", \"valor\": 420 },\n    { \"descripcion\": \"Gasolina Terpel\", \"valor\": 300 },\n    { \"descripcion\": \"Netflix\", \"valor\": 40 },\n    { \"descripcion\": \"Compra desconocida XYZ\", \"valor\": 15 }\n  ]\n}" }
          }
        },
        {
          "name": "Perfil – caso saludable",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200, etiqueta válida y factores', function () {",
            "  pm.response.to.have.status(200);",
            "  const b = pm.response.json();",
            "  pm.expect(['Saludable','En observación','En riesgo']).to.include(b.perfil_financiero);",
            "  pm.expect(b.probabilidad).to.be.within(0, 1);",
            "  pm.expect(b.factores).to.have.lengthOf.at.least(1);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{ml_url}}/perfil",
            "body": { "mode": "raw", "raw": "{\n  \"ingreso_mensual\": 4500,\n  \"nivel_endeudamiento\": 25,\n  \"frecuencia_ahorro\": \"Media\",\n  \"resumen_gastos\": { \"alimentacion\": 420, \"transporte\": 300, \"ocio\": 40 }\n}" }
          }
        },
        {
          "name": "Perfil – caso en riesgo",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('perfil En riesgo por deuda alta y gasto ≥ ingreso', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().perfil_financiero).to.eql('En riesgo');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{ml_url}}/perfil",
            "body": { "mode": "raw", "raw": "{\n  \"ingreso_mensual\": 2000,\n  \"nivel_endeudamiento\": 55,\n  \"frecuencia_ahorro\": \"Nula\",\n  \"resumen_gastos\": { \"vivienda\": 1200, \"alimentacion\": 600, \"transporte\": 250, \"ocio\": 80 }\n}" }
          }
        },
        {
          "name": "Perfil – frecuencia inválida (422)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('422 de validación', function () {",
            "  pm.response.to.have.status(422);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{ml_url}}/perfil",
            "body": { "mode": "raw", "raw": "{\n  \"ingreso_mensual\": 4500,\n  \"nivel_endeudamiento\": 25,\n  \"frecuencia_ahorro\": \"Siempre\",\n  \"resumen_gastos\": { \"ocio\": 10 }\n}" }
          }
        }
      ]
    },
    {
      "name": "finance-ai-api (backend)",
      "item": [
        {
          "name": "Health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": { "method": "GET", "url": "{{api_url}}/api/v1/health" }
        },
        {
          "name": "Version",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": { "method": "GET", "url": "{{api_url}}/api/v1/version" }
        },
        {
          "name": "Ejemplo oficial 1 – del reto (snake_case)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 con la estructura del reto', function () {",
            "  pm.response.to.have.status(200);",
            "  const b = pm.response.json();",
            "  pm.expect(b).to.have.keys(['perfil_financiero','probabilidad','resumen_gastos','recomendaciones']);",
            "  pm.expect(['Saludable','En observación','En riesgo']).to.include(b.perfil_financiero);",
            "  pm.expect(b.probabilidad).to.be.within(0, 1);",
            "  pm.expect(b.recomendaciones).to.be.an('array').that.is.not.empty;",
            "});"
          ]}}],
          "request": {
            "name": "Analisis financiero",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{api_url}}/api/v1/analisis-financiero",
            "description": "Entrada exacta del enunciado del reto. Requiere el cambio a SNAKE_CASE en application.properties.",
            "body": { "mode": "raw", "raw": "{\n  \"ingreso_mensual\": 4500,\n  \"nivel_endeudamiento\": 25,\n  \"frecuencia_ahorro\": \"Media\",\n  \"transacciones\": [\n    { \"descripcion\": \"Supermercado\", \"valor\": 420 },\n    { \"descripcion\": \"Combustible\", \"valor\": 300 },\n    { \"descripcion\": \"Streaming\", \"valor\": 40 }\n  ]\n}" }
          }
        },
        {
